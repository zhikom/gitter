#!/bin/sh
# Git post-commit hook: rebuild the web UI (npm run build) in the background after a commit on main.
# It does not install the desktop app; releases reach installed copies through the updater.

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ "$BRANCH" = "main" ]; then
    echo "[Gitter hook] Commit on main: rebuilding the web UI in the background..."
    powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File "./scripts/auto-install-main.ps1" > /dev/null 2>&1 &
fi

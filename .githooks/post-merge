#!/bin/sh
# Git post-merge hook: Auto-build and install latest main branch in background after git pull

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ "$BRANCH" = "main" ]; then
    echo "⚡ [Gitter Hook] Merge/Pull on main detected: updating installation in background..."
    powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File "./scripts/auto-install-main.ps1" > /dev/null 2>&1 &
fi

{
  "name": "gitter",
  "productName": "Gitter",
  "version": "1.2.4",
  "description": "High-performance GitKraken alternative with visual commit graph and deep AI agent integration",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "concurrently -k -n \"SERVER,VITE\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "electron:build-main": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k -n \"SERVER,VITE,ELECTRON\" -c \"blue,green,magenta\" \"npm run server\" \"npm run dev\" \"cross-env WAIT_ON_WEB=1 node electron/dev-runner.js\"",
    "electron:pack": "npm run build && npm run electron:build-main && electron-builder",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "vscode:build": "tsc -p extensions/vscode/tsconfig.json",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.145.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
